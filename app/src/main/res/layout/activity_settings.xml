<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="24dp" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Настройки" android:textSize="26sp" android:textStyle="bold"
        android:layout_marginBottom="24dp"/>
    <Button android:id="@+id/btnNotify" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Уведомления"/>
    <Button android:id="@+id/btnTheme" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Тема"
        android:layout_marginTop="8dp"/>
</LinearLayout>